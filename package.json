{
  "name": "nestjs-neo4j-migrations",
  "author": "Dmitrii Motovilov <moto.jsx@gmail.com> (http://github.com/trymoto)",
  "license": "MIT",
  "version": "0.0.6",
  "description": "Neo4j migration management for NestJs applications",
  "main": "dist/index.js",
  "bin": {
    "nestjs-neo4j-migrations": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.x"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trymoto/nestjs-neo4j-migrations.git"
  },
  "homepage": "https://github.com/trymoto/nestjs-neo4j-migrations#readme",
  "bugs": {
    "url": "https://github.com/trymoto/nestjs-neo4j-migrations/issues"
  },
  "keywords": [
    "neo4j",
    "nest",
    "nestjs",
    "migration"
  ],
  "scripts": {
    "test": "jest --verbose -i --detectOpenHandles",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "lint": "tsc --noemit && eslint \"{src,__tests__}/**/*.ts\" --fix",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "example": "ts-node ./example/main",
    "prepublishOnly": "npm run build && cp -r ./dist/* .",
    "postpublish": "git clean -fd",
    "postbuild": "chmod +x dist/cli.js"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.19.0",
    "@nestjs/common": "^11.0.6",
    "@nestjs/core": "^11.0.6",
    "@nestjs/microservices": "^11.0.6",
    "@testcontainers/neo4j": "^10.17.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.4.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "neo4j-driver": "^5.27.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "neo4j-driver": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "yargs": "^17.7.2"
  }
}
